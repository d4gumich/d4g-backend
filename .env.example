# App Configuration
DEBUG=False
LOG_LEVEL=INFO
TOKENIZERS_PARALLELISM=false
ENABLE_EXPERIMENTAL=True

# Security
EXPERIMENTAL_ACCESS_KEY="generate-a-long-secure-key-here"
# CORS_ORIGINS should be a JSON-formatted list of allowed domains
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://data4good.center", "https://d4gumich.github.io"]

# API Keys
GOOGLE_API_KEY="your_google_api_key_here"
OWL_GOOGLE_API_KEY="your_owl_google_api_key_here"
HF_TOKEN="your_huggingface_token_here"
# Practice controls. Off, a missing team key, and a wrong team key all answer 404.
# Turn this on only together with a long LIGHTHOUSE_DEV_PAGE_CODE.
LIGHTHOUSE_DEV_SCHEDULE=false
# Path code for the practice page on this API. Empty hides the page.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Do not commit a real value. Anything shorter than 32 characters stays unpublished.
LIGHTHOUSE_DEV_PAGE_CODE=

# Database Settings
POSTGRESQL_PASS="your_db_password_here"
OWL_DB_HOST="D4GUMSI-4679.postgres.pythonanywhere-services.com"
OWL_DB_PORT=14679
OWL_DB_USER="super"
OWL_DB_NAME="postgres"
OWL_DB_PASSWORD="your_owl_db_password_here"
SOCRATES_DB_URL=postgresql://user:pass@host:port/socrates_db
